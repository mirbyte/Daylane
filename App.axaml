<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Daylane.App"
             RequestedThemeVariant="Light">

    <Application.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#F4F5F7" />
        <SolidColorBrush x:Key="AppSurfaceBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AppSurfaceAltBrush" Color="#FAFBFC" />
        <SolidColorBrush x:Key="AppBorderBrush" Color="#E5E7EB" />
        <SolidColorBrush x:Key="AppTextBrush" Color="#111827" />
        <SolidColorBrush x:Key="AppMutedBrush" Color="#6B7280" />
        <SolidColorBrush x:Key="AppAccentBrush" Color="#2F9E6B" />
        <SolidColorBrush x:Key="AppAccentSoftBrush" Color="#E8F7EF" />
        <SolidColorBrush x:Key="AppIdleBrush" Color="#AEB4BE" />
        <SolidColorBrush x:Key="AppIdleSoftBrush" Color="#EEF0F3" />
        <SolidColorBrush x:Key="AppRowHoverBrush" Color="#F8FAFC" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource AppBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <Style Selector="TextBlock.brand">
            <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="-0.6" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
        </Style>

        <Style Selector="TextBlock.empty-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.empty-body">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="MaxWidth" Value="280" />
        </Style>

        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.panel-accent">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="#CDEBD9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.status-live">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Style.Animations>
                <Animation Duration="0:0:2.2"
                           IterationCount="Infinite"
                           PlaybackDirection="Alternate"
                           Easing="CubicEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="1" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="0.78" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <Style Selector="Border.status-idle">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
        </Style>

        <Style Selector="Border.segment-group">
            <Setter Property="Background" Value="#F3F4F6" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="Border.segment-thumb">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="RenderTransformOrigin" Value="0,0" />
            <Setter Property="RenderTransform" Value="translateX(0px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Smooth hover/press for custom buttons (Fluent paints ContentPresenter directly). -->
        <Style Selector="Button.tab, Button.segment, Button.date-picker, Button.date-nav, Button.secondary">
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.tab, Button.date-picker, Button.date-nav, Button.secondary">
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.12" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.tab:pressed, Button.date-picker:pressed, Button.date-nav:pressed, Button.secondary:pressed">
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <Style Selector="Button.tab /template/ ContentPresenter#PART_ContentPresenter,
                         Button.segment /template/ ContentPresenter#PART_ContentPresenter,
                         Button.date-picker /template/ ContentPresenter#PART_ContentPresenter,
                         Button.date-nav /template/ ContentPresenter#PART_ContentPresenter,
                         Button.secondary /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.tab:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#EEF0F3" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style Selector="Button.tab.active">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="Button.tab.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DCF5E8" />
            <Setter Property="Foreground" Value="{DynamicResource AppAccentBrush}" />
        </Style>

        <Style Selector="Button.segment">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="Button.segment:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#E5E7EB" />
            <Setter Property="Foreground" Value="#111827" />
        </Style>

        <Style Selector="Button.segment.active">
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style Selector="Button.segment.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>

        <Style Selector="Button.date-picker">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style Selector="Border.date-picker">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style Selector="Button.date-picker:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F9FAFB" />
        </Style>

        <Style Selector="Button.date-nav">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.date-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F9FAFB" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
        </Style>

        <Style Selector="Button.date-nav:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="{DynamicResource AppSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
        </Style>

        <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F3F4F6" />
        </Style>

        <Style Selector="Border.app-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.app-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
        </Style>

        <Style Selector="Border.legend-swatch">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="TextBlock.legend-label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource AppMutedBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style Selector="ListBox.plain-list">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style Selector="ListBox.plain-list ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="ListBox.plain-list ListBoxItem /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="ListBox.plain-list ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
        </Style>

        <Style Selector="ListBox.plain-list ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        </Style>

        <Style Selector="ListBox.plain-list ListBoxItem:selected:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DCF5E8" />
        </Style>
    </Application.Styles>
</Application>
